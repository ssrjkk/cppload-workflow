@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Boost 1.83 COMPONENTS system)
find_dependency(OpenSSL 3.0)
find_dependency(Threads)
find_dependency(yaml-cpp)

set(volley_HAVE_PROMETHEUS @VOLLEY_HAVE_PROMETHEUS@)
if(volley_HAVE_PROMETHEUS)
    find_dependency(prometheus-cpp)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/volley-targets.cmake")

check_required_components(volley)
