@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Boost 1.83 COMPONENTS system)
find_dependency(OpenSSL 3.0)
find_dependency(Threads)

set(cppload_HAVE_PROMETHEUS @CPLOAD_HAVE_PROMETHEUS@)
if(cppload_HAVE_PROMETHEUS)
    find_dependency(prometheus-cpp)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/cppload-targets.cmake")

check_required_components(cppload)
